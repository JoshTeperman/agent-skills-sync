#!/usr/bin/env bash
# Run bin/link if the last pull or rebase touched skills/, capabilities/, or bin/.
root="$(git rev-parse --show-toplevel)"
if ! git rev-parse -q --verify ORIG_HEAD >/dev/null; then exec "$root/bin/link"; fi
if [ -n "$(git diff --name-only ORIG_HEAD HEAD -- skills/ capabilities/ bin/)" ]; then exec "$root/bin/link"; fi
